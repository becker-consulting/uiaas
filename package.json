{
  "name": "uiaas",
  "version": "0.1.0",
  "private": true,
  "description": "Useless Information as a Service — a parody SaaS that returns random, entirely useless facts.",
  "type": "module",
  "license": "MIT",
  "author": "Henrik Becker Consulting AB",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply uiaas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply uiaas-db --remote",
    "db:seed:local": "wrangler d1 execute uiaas-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute uiaas-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260831.1": true
  }
}
