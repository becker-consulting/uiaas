{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uiaas",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uiaas-db",
      // Placeholder — replace after running `wrangler d1 create uiaas-db` (see README).
      "database_id": "6c7b83b3-908f-4402-9962-dbba63bef160",
      "migrations_dir": "migrations"
    }
  ],
  // Native Workers rate limiting for POST /api/v1/fact — the one genuinely
  // unauthenticated public write endpoint. No zone/custom domain needed;
  // this works on the *.workers.dev deployment too. `period` is fixed by
  // the platform to 10 or 60 seconds (burst protection, not a long-window
  // quota) — see routes/api.ts and CLAUDE.md for why 5/60s.
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
